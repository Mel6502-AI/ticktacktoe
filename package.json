{
  "name": "ticktacktoe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "build:mac": "npm run build && electron-builder --mac dmg --publish never",
    "build:win": "npm run build && electron-builder -w zip --publish never",
    "build:linux": "npm run build && electron-builder -l tar.gz --publish never",
    "build:all": "npm run build && electron-builder -mwl --publish never"
  },
  "build": {
    "appId": "com.melvynkui.tictactoe",
    "productName": "TicTacToe-Arena",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Game"
    }
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
